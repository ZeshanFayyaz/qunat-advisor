# ==============================================================================
# QUNAT ADVISOR BACKEND — ENVIRONMENT CONFIG
# ==============================================================================
# Copy this file to .env for local runs.
# For Railway deploy, paste these into the service's Variables tab.
# ==============================================================================

# Runtime mode:
#   demo  → keyword-heuristic classifier, no Anthropic calls (free, fast)
#   live  → real Claude Sonnet via Anthropic API (production)
MODE=demo

# Required only when MODE=live. Generate at console.anthropic.com.
# Set a monthly spend cap under Settings → Limits before going live.
ANTHROPIC_API_KEY=

# Model overrides (optional — defaults are sensible)
ANTHROPIC_MODEL_CLASSIFIER=claude-sonnet-4-5
ANTHROPIC_MODEL_GENERATOR=claude-sonnet-4-5

# Port Railway or Vercel override this automatically
PORT=8787

# ------------------------------------------------------------------------------
# CORS — which origins can call this backend
# ------------------------------------------------------------------------------
# Comma-separated list. Supports * wildcards for subdomains.
#
# Local dev:
#   http://localhost:5173,http://localhost:4173
#
# Production (Qunat Beauty):
#   https://qunatbeauty.com,https://www.qunatbeauty.com,https://*.myshopify.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ------------------------------------------------------------------------------
# Shopify live-fetch — where to pull prices, images, discounts from
# ------------------------------------------------------------------------------
# Just the domain, no https:// prefix.
# Qunat production: qunatbeauty.com
SHOPIFY_STORE_DOMAIN=qunatbeauty.com
